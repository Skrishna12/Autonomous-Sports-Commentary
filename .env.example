# Copy to .env and fill values. Never commit real keys.

# Database — local SQLite by default; RDS Postgres in AWS
DATABASE_URL=sqlite:///data/ascs.db
# DATABASE_URL=postgresql+psycopg2://ascs:ascs@postgres:5432/ascs

# Replay
REPLAY_INTERVAL_SECONDS=3
DEFAULT_MATCH_ID=1534209

# LLM (optional). Leave empty to use the grounded template agents.
# Open-weight default: Qwen3 via an OpenAI-compatible local server (Ollama/vLLM).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3:8b
JUDGE_MODEL=qwen3:8b

# Speech
TTS_ENGINE=synthetic
# TTS_ENGINE=kokoro
ASR_ENGINE=disabled
# ASR_ENGINE=faster-whisper
TTS_SERVICE_URL=http://tts:8001
ASR_SERVICE_URL=http://asr:8002
DEFAULT_LANGUAGE=en

# Object storage (local disk or S3)
RAW_DATA_DIR=data/raw
PARQUET_DIR=data/parquet
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=commentary-eval

# API / UI
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_API_URL=http://api:8000

# Cursor SDK orchestration (optional, 15-day follow-on agents)
CURSOR_API_KEY=
